# Public application origin used to validate callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_USER_NAME=Tiago
NEXT_PUBLIC_DEMO_USER_EMAIL=modo@demonstracao.pt

# Supabase PostgreSQL. The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Use "mock" for an entirely local demonstration or "enablebanking" for Enable Banking AIS.
BANK_DATA_PROVIDER=mock
BANK_DATA_ENVIRONMENT=sandbox
BANK_DATA_ACCESS_VALID_DAYS=90

# Required only when BANK_DATA_PROVIDER=enablebanking. Keep both values server-only.
ENABLE_BANKING_APPLICATION_ID=
# PKCS#8 RSA private key. Escaped newlines (\n) are accepted in hosted environments.
ENABLE_BANKING_PRIVATE_KEY=
# Optional override for compatible test proxies. The official endpoint is used by default.
ENABLE_BANKING_API_URL=https://api.enablebanking.com

# Vercel sends this bearer secret to the scheduled synchronization endpoint.
CRON_SECRET=
