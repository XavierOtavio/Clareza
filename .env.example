# Public application origin used to validate callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_USER_NAME=Tiago
NEXT_PUBLIC_DEMO_USER_EMAIL=modo@demonstracao.pt

# Supabase PostgreSQL. The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Use "mock" for an entirely local demonstration or "gocardless" for Bank Account Data.
BANK_DATA_PROVIDER=mock
BANK_DATA_ENVIRONMENT=sandbox
BANK_DATA_ACCESS_VALID_DAYS=90
BANK_DATA_HISTORY_DAYS=90

# Required only when BANK_DATA_PROVIDER=gocardless. Keep both values server-only.
GOCARDLESS_BANK_ACCOUNT_DATA_SECRET_ID=
GOCARDLESS_BANK_ACCOUNT_DATA_SECRET_KEY=

# Vercel sends this bearer secret to the scheduled synchronization endpoint.
CRON_SECRET=
