# Public application origin used to validate callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The first vertical slice uses "mock" only. Configure a licensed AISP in phase 3.
BANK_DATA_PROVIDER=mock
BANK_DATA_CLIENT_ID=
BANK_DATA_CLIENT_SECRET=
BANK_DATA_WEBHOOK_SECRET=

# Generate a 32-byte key in the production secret manager. Never commit its value.
BANK_TOKEN_ENCRYPTION_KEY=
